{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Document attachment record, version 1",
  "description": "The result adapter-document writes for one document (docs/design/attachments.md). The producer's schema: strict, enumerations closed. The design note is normative and lists what this schema cannot check; a consumer validates for compatibility (unknown members and enumeration values tolerated), not with this schema.",
  "type": "object",
  "required": [
    "attachmentVersion",
    "document",
    "original",
    "content",
    "processing",
    "provenance"
  ],
  "properties": {
    "attachmentVersion": {
      "const": "1"
    },
    "document": {
      "type": "object",
      "required": [
        "id",
        "name",
        "mediaType",
        "detectedMediaType",
        "size",
        "version",
        "encryption"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/digest"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "description": "at most 255 bytes of UTF-8; maxLength counts code points and cannot express that"
        },
        "mediaType": {
          "type": "string"
        },
        "detectedMediaType": {
          "type": [
            "string",
            "null"
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "encryption": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "handler",
            "revision",
            "opened"
          ],
          "properties": {
            "handler": {
              "type": "string"
            },
            "revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "opened": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "original": {
      "type": "object",
      "required": [
        "retention",
        "encoding",
        "bytes"
      ],
      "properties": {
        "retention": {
          "enum": [
            "caller",
            "inline"
          ]
        },
        "encoding": {
          "enum": [
            "base64",
            null
          ]
        },
        "bytes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "content": {
      "type": "object",
      "required": [
        "kind",
        "extraction",
        "pageCount",
        "truncated",
        "chars",
        "pages"
      ],
      "properties": {
        "kind": {
          "const": "text"
        },
        "extraction": {
          "enum": [
            "text-layer",
            "ocr",
            "mixed",
            "verbatim",
            "none"
          ]
        },
        "pageCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "truncated": {
          "type": "boolean"
        },
        "chars": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "pages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "number",
              "status",
              "extraction",
              "text",
              "chars",
              "unmapped"
            ],
            "properties": {
              "number": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "status": {
                "enum": [
                  "ok",
                  "no-text",
                  "needs-ocr",
                  "failed"
                ]
              },
              "extraction": {
                "enum": [
                  "text-layer",
                  "ocr",
                  "verbatim",
                  "none"
                ]
              },
              "text": {
                "type": "string"
              },
              "chars": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "unmapped": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "processing": {
      "type": "object",
      "required": [
        "status",
        "errors",
        "bounds",
        "durationMs"
      ],
      "properties": {
        "status": {
          "enum": [
            "complete",
            "partial",
            "failed"
          ]
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code",
              "message",
              "page"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string",
                "maxLength": 512,
                "description": "at most 512 bytes of UTF-8; maxLength counts code points and cannot express that"
              },
              "page": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "additionalProperties": false
          }
        },
        "bounds": {
          "type": "object",
          "required": [
            "maxBytes",
            "maxPages",
            "maxTextBytes",
            "maxInflateBytes",
            "maxOcrOutputBytes",
            "timeoutMs"
          ],
          "properties": {
            "maxBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "maxPages": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "maxTextBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "maxInflateBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "maxOcrOutputBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "adapter",
        "source",
        "observedAt",
        "processor",
        "ocr"
      ],
      "properties": {
        "adapter": {
          "type": "object",
          "required": [
            "name",
            "version",
            "digest"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "digest": {
              "$ref": "#/$defs/digest"
            }
          },
          "additionalProperties": false
        },
        "source": {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string"
            }
          }
        },
        "observedAt": {
          "type": "string",
          "description": "YYYY-MM-DDThh:mm:ssZ, UTC, whole seconds"
        },
        "processor": {
          "type": [
            "string",
            "null"
          ]
        },
        "ocr": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "program",
            "digest",
            "pages"
          ],
          "properties": {
            "program": {
              "type": "string"
            },
            "digest": {
              "$ref": "#/$defs/digest"
            },
            "pages": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "description": "\"sha256:\" followed by exactly 64 lowercase hexadecimal characters",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "processing": {
            "properties": {
              "status": {
                "const": "failed"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "properties": {
              "pages": {
                "maxItems": 0
              },
              "extraction": {
                "const": "none"
              }
            }
          },
          "processing": {
            "properties": {
              "errors": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "processing": {
            "properties": {
              "status": {
                "const": "partial"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "processing": {
            "properties": {
              "errors": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "processing": {
            "properties": {
              "status": {
                "const": "complete"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "properties": {
              "truncated": {
                "const": false
              }
            }
          },
          "processing": {
            "properties": {
              "errors": {
                "maxItems": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "original": {
            "properties": {
              "retention": {
                "const": "inline"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "original": {
            "properties": {
              "encoding": {
                "const": "base64"
              },
              "bytes": {
                "type": "string"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "original": {
            "properties": {
              "encoding": {
                "const": null
              },
              "bytes": {
                "const": null
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
