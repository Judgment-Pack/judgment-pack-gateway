{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Document attachment record, version 1",
  "description": "The result adapter-document writes for one document (docs/design/attachments.md). The producer's schema: members and enumerations closed. The design note is normative, and names rules this schema does not hold; a consumer validates for compatibility (unknown members and enumeration values tolerated), not with this schema.",
  "type": "object",
  "required": [
    "attachmentVersion",
    "document",
    "original",
    "content",
    "processing",
    "provenance"
  ],
  "properties": {
    "attachmentVersion": {
      "const": "1"
    },
    "document": {
      "type": "object",
      "required": [
        "id",
        "name",
        "mediaType",
        "detectedMediaType",
        "size",
        "version",
        "encryption"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/digest"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^\\u0000-\\u001F\\u007F]+$",
          "description": "at most 255 bytes of UTF-8, no control character; maxLength counts code points, so the byte limit is an application check"
        },
        "mediaType": {
          "type": "string",
          "maxLength": 255,
          "pattern": "^[a-z0-9][a-z0-9!#$&^_.+-]{0,126}/[a-z0-9][a-z0-9!#$&^_.+-]{0,126}$"
        },
        "detectedMediaType": {
          "enum": [
            "application/pdf",
            "text/plain",
            null
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "encryption": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "handler",
            "revision",
            "opened"
          ],
          "properties": {
            "handler": {
              "type": "string"
            },
            "revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "opened": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "original": {
      "type": "object",
      "required": [
        "retention",
        "encoding",
        "bytes"
      ],
      "properties": {
        "retention": {
          "enum": [
            "caller",
            "inline"
          ]
        },
        "encoding": {
          "enum": [
            "base64",
            null
          ]
        },
        "bytes": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 4,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      },
      "additionalProperties": false
    },
    "content": {
      "type": "object",
      "required": [
        "kind",
        "extraction",
        "pageCount",
        "truncated",
        "chars",
        "pages"
      ],
      "properties": {
        "kind": {
          "const": "text"
        },
        "extraction": {
          "enum": [
            "text-layer",
            "ocr",
            "mixed",
            "verbatim",
            "none"
          ]
        },
        "pageCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "truncated": {
          "type": "boolean"
        },
        "chars": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "pages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/page"
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "extraction": {
                "const": "none"
              }
            }
          },
          "then": {
            "properties": {
              "pages": {
                "items": {
                  "properties": {
                    "extraction": {
                      "enum": [
                        "none"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "extraction": {
                "const": "text-layer"
              }
            }
          },
          "then": {
            "properties": {
              "pages": {
                "items": {
                  "properties": {
                    "extraction": {
                      "enum": [
                        "text-layer",
                        "none"
                      ]
                    }
                  }
                },
                "contains": {
                  "properties": {
                    "extraction": {
                      "const": "text-layer"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "extraction": {
                "const": "ocr"
              }
            }
          },
          "then": {
            "properties": {
              "pages": {
                "items": {
                  "properties": {
                    "extraction": {
                      "enum": [
                        "ocr",
                        "none"
                      ]
                    }
                  }
                },
                "contains": {
                  "properties": {
                    "extraction": {
                      "const": "ocr"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "extraction": {
                "const": "mixed"
              }
            }
          },
          "then": {
            "properties": {
              "pages": {
                "items": {
                  "properties": {
                    "extraction": {
                      "enum": [
                        "text-layer",
                        "ocr",
                        "none"
                      ]
                    }
                  }
                },
                "allOf": [
                  {
                    "contains": {
                      "properties": {
                        "extraction": {
                          "const": "text-layer"
                        }
                      }
                    }
                  },
                  {
                    "contains": {
                      "properties": {
                        "extraction": {
                          "const": "ocr"
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "extraction": {
                "const": "verbatim"
              }
            }
          },
          "then": {
            "properties": {
              "pages": {
                "items": {
                  "properties": {
                    "extraction": {
                      "enum": [
                        "verbatim",
                        "none"
                      ]
                    }
                  }
                },
                "contains": {
                  "properties": {
                    "extraction": {
                      "const": "verbatim"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "processing": {
      "type": "object",
      "required": [
        "status",
        "errors",
        "bounds",
        "durationMs"
      ],
      "properties": {
        "status": {
          "enum": [
            "complete",
            "partial",
            "failed"
          ]
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/error"
          }
        },
        "bounds": {
          "type": "object",
          "required": [
            "maxBytes",
            "maxPages",
            "maxTextBytes",
            "maxInflateBytes",
            "maxOcrOutputBytes",
            "timeoutMs"
          ],
          "properties": {
            "maxBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "maxPages": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "maxTextBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "maxInflateBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "maxOcrOutputBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "adapter",
        "source",
        "observedAt",
        "processor",
        "ocr"
      ],
      "properties": {
        "adapter": {
          "type": "object",
          "required": [
            "name",
            "version",
            "digest"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string"
            },
            "digest": {
              "$ref": "#/$defs/digest"
            }
          },
          "additionalProperties": false
        },
        "source": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "inline"
                }
              },
              "additionalProperties": false
            }
          ],
          "description": "one variant per source kind; version 1 has one, and a later kind is added with its members as the note's changelog records"
        },
        "observedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "description": "YYYY-MM-DDThh:mm:ssZ, UTC, whole seconds; that the date and time exist is an application check"
        },
        "processor": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "ocr": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "program",
            "digest",
            "pages"
          ],
          "properties": {
            "program": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "$ref": "#/$defs/digest"
            },
            "pages": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "description": "\"sha256:\" followed by exactly 64 lowercase hexadecimal characters",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "page": {
      "type": "object",
      "required": [
        "number",
        "status",
        "extraction",
        "text",
        "chars",
        "unmapped"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "status": {
          "enum": [
            "ok",
            "no-text",
            "needs-ocr",
            "failed"
          ]
        },
        "extraction": {
          "enum": [
            "text-layer",
            "ocr",
            "verbatim",
            "none"
          ]
        },
        "text": {
          "type": "string",
          "pattern": "^[^\\u0000-\\u0008\\u000B-\\u001F\\u007F]*$",
          "description": "normalised text (docs/design/attachments.md, Text normalisation): no carriage return and no control character but tab and line feed; the other normalisation rules are application checks"
        },
        "chars": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unmapped": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "ok"
              }
            }
          },
          "then": {
            "properties": {
              "text": {
                "minLength": 1
              },
              "extraction": {
                "enum": [
                  "text-layer",
                  "ocr",
                  "verbatim"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "no-text"
              }
            }
          },
          "then": {
            "properties": {
              "text": {
                "const": ""
              },
              "chars": {
                "const": 0
              },
              "extraction": {
                "enum": [
                  "text-layer",
                  "ocr",
                  "verbatim"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "needs-ocr",
                  "failed"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "text": {
                "const": ""
              },
              "chars": {
                "const": 0
              },
              "extraction": {
                "const": "none"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "extraction": {
                "const": "text-layer"
              }
            }
          },
          "then": true,
          "else": {
            "properties": {
              "unmapped": {
                "const": 0
              }
            }
          }
        }
      ]
    },
    "error": {
      "type": "object",
      "required": [
        "code",
        "message",
        "page"
      ],
      "properties": {
        "code": {
          "enum": [
            "media-type-unsupported",
            "media-type-mismatch",
            "document-over-bound",
            "document-empty",
            "pdf-malformed",
            "pdf-encrypted",
            "pdf-unsupported",
            "pdf-page-failed",
            "pdf-pages-over-bound",
            "text-over-bound",
            "stream-over-bound",
            "timeout",
            "ocr-not-run",
            "ocr-failed",
            "ocr-incomplete",
            "ocr-timeout"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 512,
          "description": "at most 512 bytes of UTF-8; maxLength counts code points, so the byte limit is an application check"
        },
        "page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "processing": {
            "properties": {
              "status": {
                "const": "failed"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "properties": {
              "pages": {
                "maxItems": 0
              }
            }
          },
          "processing": {
            "properties": {
              "errors": {
                "minItems": 1,
                "items": {
                  "properties": {
                    "code": {
                      "not": {
                        "enum": [
                          "pdf-page-failed",
                          "ocr-not-run",
                          "ocr-failed",
                          "ocr-incomplete",
                          "ocr-timeout"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "processing": {
            "properties": {
              "status": {
                "const": "partial"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "properties": {
              "pages": {
                "minItems": 1
              }
            }
          },
          "processing": {
            "properties": {
              "errors": {
                "minItems": 1,
                "items": {
                  "properties": {
                    "code": {
                      "not": {
                        "enum": [
                          "media-type-unsupported",
                          "media-type-mismatch",
                          "document-over-bound",
                          "document-empty",
                          "pdf-malformed",
                          "pdf-encrypted"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "processing": {
            "properties": {
              "status": {
                "const": "complete"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "properties": {
              "truncated": {
                "const": false
              },
              "pages": {
                "minItems": 1,
                "items": {
                  "properties": {
                    "status": {
                      "enum": [
                        "ok",
                        "no-text"
                      ]
                    }
                  }
                }
              }
            }
          },
          "processing": {
            "properties": {
              "errors": {
                "maxItems": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "content": {
            "properties": {
              "pages": {
                "contains": {
                  "properties": {
                    "extraction": {
                      "const": "ocr"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "provenance": {
            "properties": {
              "ocr": {
                "type": "object"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "provenance": {
            "properties": {
              "ocr": {
                "const": null
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "processing": {
            "properties": {
              "errors": {
                "contains": {
                  "properties": {
                    "code": {
                      "enum": [
                        "ocr-not-run",
                        "ocr-failed",
                        "ocr-timeout"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "properties": {
              "pages": {
                "items": {
                  "properties": {
                    "extraction": {
                      "not": {
                        "const": "ocr"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "document": {
            "properties": {
              "encryption": {
                "type": "object",
                "properties": {
                  "opened": {
                    "const": false
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "processing": {
            "properties": {
              "status": {
                "const": "failed"
              },
              "errors": {
                "contains": {
                  "properties": {
                    "code": {
                      "const": "pdf-encrypted"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "processing": {
            "properties": {
              "errors": {
                "contains": {
                  "properties": {
                    "code": {
                      "enum": [
                        "pdf-encrypted"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "document": {
            "properties": {
              "encryption": {
                "type": "object",
                "properties": {
                  "opened": {
                    "const": false
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "processing": {
            "properties": {
              "errors": {
                "contains": {
                  "properties": {
                    "code": {
                      "enum": [
                        "media-type-unsupported",
                        "media-type-mismatch",
                        "document-over-bound",
                        "document-empty"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "provenance": {
            "properties": {
              "processor": {
                "const": null
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "provenance": {
            "properties": {
              "processor": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provenance": {
            "properties": {
              "source": {
                "properties": {
                  "kind": {
                    "const": "inline"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "document": {
            "properties": {
              "version": {
                "const": null
              }
            }
          },
          "original": {
            "properties": {
              "retention": {
                "const": "caller"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "original": {
            "properties": {
              "retention": {
                "const": "inline"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "original": {
            "properties": {
              "encoding": {
                "const": "base64"
              },
              "bytes": {
                "type": "string"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "original": {
            "properties": {
              "encoding": {
                "const": null
              },
              "bytes": {
                "const": null
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
