# Corpus vectors are byte-exact fixtures. A line-ending conversion silently
# invalidates every HMAC in them, so they are never treated as convertible text.
corpus/** -text

# The recorded rendering is compared byte for byte with the frontend's own.
testdata/tool-descriptors/rendered.json -text

# The stdio form of adapter-mcp is held to these records byte for byte.
adapters/mcp/testdata/stdio-golden/** -text

# A stdio write's action receipt is held to these records byte for byte.
go/testdata/action-golden/** -text

# The search source is held to the records it wrote before ADR-0019 byte for byte.
adapters/connections/testdata/*-golden*.jsonl -text

# Whitespace is part of these fixtures and scripts' bytes, so git diff --check (dev.json) skips them.
adapters/document/testdata/*.pdf -whitespace
adapters/document/testdata/notes.txt -whitespace
testdata/rendering/standin-renderer -whitespace
verify-ts/src/citations.ts whitespace=-blank-at-eof

# The hand-written export is held to its manifest byte for byte.
go/testdata/export/** -text
