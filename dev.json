{
  "version": 1,
  "toolchains": {"node": {"version": "22"}, "go": {}, "python": {"version": "3.12", "venv": ".venv"}},
  "setup": [
    {"name": "python-deps", "run": "python3 -m pip install --disable-pip-version-check -q -r testdata/attachments/schema-requirements.txt", "toolchain": "python", "timeout": 600},
    {"name": "npm-ci-n8n", "run": "npm ci --ignore-scripts --no-audit --no-fund", "toolchain": "node", "cwd": "plugins/n8n-nodes-judgment-pack", "timeout": 900},
    {"name": "npm-ci-activepieces", "run": "npm ci --ignore-scripts --no-audit --no-fund", "toolchain": "node", "cwd": "plugins/activepieces/judgment-pack", "timeout": 900},
    {"name": "npm-ci-verify-ts", "run": "npm ci --ignore-scripts --no-audit --no-fund", "toolchain": "node", "cwd": "verify-ts", "timeout": 900}
  ],
  "checks": [
    {"name": "local-paths", "run": "scripts/checks/local-paths.sh", "toolchain": "shell"},
    {"name": "agent-docs", "run": "scripts/sync-agent-docs.sh --check .", "toolchain": "shell", "summary": "^sync-agent-docs:"},
    {"name": "diff-check", "run": "git diff --check \"$(git hash-object -t tree /dev/null)\"", "toolchain": "shell"},
    {"name": "go-fmt", "run": "test -z \"$(gofmt -l .)\" || { gofmt -l .; exit 1; }", "toolchain": "go", "cwd": "go", "timeout": 600},
    {"name": "go-vet", "run": "go vet ./...", "toolchain": "go", "cwd": "go", "timeout": 3000},
    {"name": "go-test", "run": "go test ./...", "toolchain": "go", "cwd": "go", "summary": "^(ok|FAIL|---) ", "timeout": 3000},
    {"name": "go-build", "run": "go build -buildvcs=false -o gateway .", "toolchain": "go", "cwd": "go", "timeout": 3000},
    {"name": "conform", "run": "./gateway conform", "toolchain": "go", "cwd": "go", "summary": "vectors|disagreement", "timeout": 3000},
    {"name": "smoke-stand-in", "run": "GATEWAY_BIN=\"$PWD/gateway\" SMOKE_REQUIRE_ENGINE=1 python3 -m unittest discover -s ../plugins/smoke/testing -p test_stand_in_engine.py -v", "toolchain": "python", "cwd": "go", "summary": "^(Ran |OK|FAILED)", "timeout": 600},
    {"name": "no-third-party-modules", "run": "../scripts/checks/no-third-party-modules.sh", "toolchain": "go", "cwd": "go", "timeout": 3000},
    {"name": "core-resolves-into-stdlib", "run": "../scripts/checks/core-resolves-into-stdlib.sh", "toolchain": "go", "cwd": "go", "timeout": 3000},
    {"name": "adapters-fmt", "run": "export GOWORK=off; test -z \"$(gofmt -l .)\" || { gofmt -l .; exit 1; }", "toolchain": "go", "cwd": "adapters", "timeout": 600},
    {"name": "adapters-vet", "run": "export GOWORK=off; go vet ./...", "toolchain": "go", "cwd": "adapters", "timeout": 3000},
    {"name": "adapters-vet-windows", "run": "export GOWORK=off; GOOS=windows go vet ./...", "toolchain": "go", "cwd": "adapters", "timeout": 3000},
    {"name": "sandbox-boundary", "run": "export GOWORK=off; go test -count=1 -timeout 90s ./internal/sandbox", "toolchain": "go", "cwd": "adapters", "summary": "^(ok|FAIL|---) ", "timeout": 120},
    {"name": "adapters-test", "run": "export GOWORK=off; go test ./...", "toolchain": "go", "cwd": "adapters", "summary": "^(ok|FAIL|---) ", "timeout": 3000},
    {"name": "adapters-build", "run": "export GOWORK=off; go build -buildvcs=false ./...", "toolchain": "go", "cwd": "adapters", "timeout": 3000},
    {"name": "acquisition-fixture", "run": "../scripts/checks/acquisition-fixture.sh", "toolchain": "go", "cwd": "adapters", "summary": "^(ok|FAIL|---) ", "timeout": 3000},
    {"name": "attachment-schemas", "run": "../scripts/checks/attachment-schemas.sh", "toolchain": "go", "cwd": "adapters", "summary": "^(ok|FAIL|---) ", "timeout": 3000},
    {"name": "rendering-schemas", "run": "../scripts/checks/rendering-schemas.sh", "toolchain": "go", "cwd": "adapters", "summary": "^PASS", "timeout": 3000},
    {"name": "search-schema", "run": "../scripts/checks/search-schema.sh", "toolchain": "go", "cwd": "adapters", "summary": "^(ok|FAIL|---) ", "timeout": 3000},
    {"name": "adapter-envelope-schema", "run": "python3 schema/check_adapter_envelope.py", "toolchain": "python", "summary": "^PASS", "timeout": 600},
    {"name": "adapter-conform", "run": "../scripts/checks/adapter-conform.sh", "toolchain": "go", "cwd": "adapters", "summary": "adapter-conform: [0-9]+ runs|^PASS|^FAIL|^--- FAIL", "timeout": 3000},
    {"name": "descriptor-vectors", "run": "export GOWORK=off; python3 make_vectors.py && git diff --exit-code -- vectors.json", "toolchain": "python", "cwd": "testdata/tool-descriptors", "timeout": 600},
    {"name": "descriptor-metaschema", "run": "export GOWORK=off; go vet ./... && go test ./...", "toolchain": "go", "cwd": "testdata/tool-descriptors/metaschema", "summary": "^(ok|FAIL|---) ", "timeout": 3000},
    {"name": "descriptor-commonmark", "run": "export GOWORK=off; go vet ./... && go test ./...", "toolchain": "go", "cwd": "testdata/tool-descriptors/commonmark", "summary": "^(ok|FAIL|---) ", "timeout": 3000},
    {"name": "adapters-not-into-core", "run": "../scripts/checks/adapters-not-into-core.sh", "toolchain": "go", "cwd": "adapters", "timeout": 3000},
    {"name": "release-toolchain", "run": "scripts/checks/release-toolchain.sh", "toolchain": "go", "timeout": 600},
    {"name": "third-party-notices", "run": "export GOWORK=off; python3 build/third_party_notices.py --check", "toolchain": "go", "timeout": 3000},
    {"name": "release-programs", "run": "scripts/checks/release-programs.sh", "toolchain": "shell", "timeout": 600},
    {"name": "release-archives", "run": "export GOWORK=off; python3 build/test_release_archives.py", "toolchain": "go", "summary": "^(Ran |OK|FAILED)", "timeout": 3000},
    {"name": "no-publisher-registration", "run": "scripts/checks/no-publisher-registration.sh", "toolchain": "shell", "timeout": 600},
    {"name": "ci-evidence", "run": "python3 .github/test_ci_evidence.py", "toolchain": "python", "summary": "^(Ran |OK|FAILED)", "timeout": 600},
    {"name": "n8n-build", "run": "npm run build", "toolchain": "node", "cwd": "plugins/n8n-nodes-judgment-pack", "timeout": 900},
    {"name": "n8n-lint", "run": "npm run lint", "toolchain": "node", "cwd": "plugins/n8n-nodes-judgment-pack", "timeout": 900},
    {"name": "n8n-test", "run": "npm test", "toolchain": "node", "cwd": "plugins/n8n-nodes-judgment-pack", "summary": "^# (tests|pass|fail)", "timeout": 900},
    {"name": "n8n-smoke-checkers", "run": "SMOKE_REQUIRE_PIECE= python3 -m unittest discover -s plugins/smoke/testing -v", "toolchain": "python", "summary": "^(Ran |OK|FAILED)", "timeout": 600},
    {"name": "activepieces-build", "run": "npm run build", "toolchain": "node", "cwd": "plugins/activepieces/judgment-pack", "timeout": 900},
    {"name": "activepieces-lint", "run": "npm run lint", "toolchain": "node", "cwd": "plugins/activepieces/judgment-pack", "timeout": 900},
    {"name": "activepieces-test", "run": "npm test", "toolchain": "node", "cwd": "plugins/activepieces/judgment-pack", "summary": "^# (tests|pass|fail)", "timeout": 900},
    {"name": "activepieces-smoke-checkers", "run": "SMOKE_REQUIRE_PIECE=1 python3 -m unittest discover -s plugins/smoke/testing -v", "toolchain": "python", "summary": "^(Ran |OK|FAILED)", "timeout": 600},
    {"name": "verify-ts-typecheck", "run": "npm run typecheck", "toolchain": "node", "cwd": "verify-ts", "timeout": 900},
    {"name": "verify-ts-test", "run": "npm test", "toolchain": "node", "cwd": "verify-ts", "summary": "^# (tests|pass|fail)", "timeout": 900},
    {"name": "verify-ts-conform", "run": "go build -buildvcs=false -o gateway . && ./gateway conform --impl ../verify-ts/impl", "toolchain": "go", "cwd": "go", "summary": "vectors|disagreement", "timeout": 3000},
    {"name": "verify-ts-witness-chain", "run": "GATEWAY_VERIFY_TS_IMPL=\"$PWD/../verify-ts/impl\" go test -count=1 -run '^TestWitnessServedChainReadsCleanly$' -v .", "toolchain": "go", "cwd": "go", "summary": "^(ok|FAIL|---) ", "timeout": 3000},
    {"name": "image-checks-test", "run": "python3 .github/test_image_checks.py", "toolchain": "python", "summary": "^(Ran |OK|FAILED)", "timeout": 600},
    {"name": "image-build", "run": "DOCKER_BUILDKIT=1 docker build --tag engine:ci .", "toolchain": "shell", "timeout": 1800},
    {"name": "image-corpus", "run": "docker run --rm engine:ci conform --corpus /usr/share/engine/corpus", "toolchain": "shell", "timeout": 600},
    {"name": "image-filesystem", "run": "scripts/checks/image-filesystem.sh", "toolchain": "shell", "timeout": 1200},
    {"name": "image-root-unwritable", "run": "scripts/checks/image-root-unwritable.sh", "toolchain": "shell", "timeout": 1800},
    {"name": "image-runs", "run": "scripts/checks/image-runs.sh", "toolchain": "shell", "timeout": 1200},
    {"name": "image-evaluates", "run": "scripts/checks/image-evaluates.sh", "toolchain": "shell", "timeout": 1200},
    {"name": "image-launch-overrides", "run": "scripts/checks/image-launch-overrides.sh", "toolchain": "shell", "timeout": 600},
    {"name": "witness-scenario", "run": "../scripts/checks/witness-scenario.sh", "toolchain": "go", "cwd": "go", "summary": "^(ok|FAIL|---) ", "timeout": 3000},
    {"name": "both-paths-agree", "run": "export GOWORK=off AGREEMENT_RUNTIME=docker; go test -count=1 -timeout 25m -run TestBothPathsAgreeOnAFreshFetch -v ./agreement/", "toolchain": "go", "cwd": "adapters", "summary": "^(ok|FAIL|---) ", "timeout": 3000}
  ],
  "handover": {
    "boundary_paths": ["adapters/mcp", "adapters/mcphttp", "adapters/agreement", "adapters/attachment"],
    "shared_paths": ["corpus", "catalog", "docs/adr"]
  }
}
